IO.inspect(Time.utc_now())
data.()
|> Day10.solve1()
|> IO.inspect(label: "\n*** Part 1 solution (example: 7)")
# 447

data.()
|> Day10.solve2()
|> IO.inspect(label: "\n*** Part 2 solution (example: )")
