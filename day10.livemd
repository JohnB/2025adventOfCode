## Solution

```elixir
defmodule Day10 do
  @parser ~r/\[(.*)\] +(.*) +\{(.*)\}/
  def parse_line(line) do
    [_full, diagram, wiring, joltage] = Regex.run(@parser, line)
    wiring = wiring
      |> String.split(" ", trim: true)
      |> Enum.map(fn csv ->
        csv
        |> String.slice(1..-2//1)
        |> String.split(",")
        |> Enum.map(&String.to_integer/1)
      end)
    diagram = diagram
      |> AOC.inspect()
      |> String.split("", trim: true)
      |> Enum.with_index()
      # |> AOC.inspect(label: "17")
      |> Enum.reduce(%{}, fn {char, index}, acc -> Map.put(acc, index, char == "#") end)
      # |> AOC.inspect(label: "19")

    [diagram, wiring, joltage]
    # |> AOC.inspect()
  end

  @no_convergence 500
  def toggle(state, wires) do
    wires
    |> Enum.reduce(state, fn index, acc ->
      Map.update!(acc, index, fn boolean -> !boolean end)
    end)
  end

  # There is no point in applying the same wiring twice, so max depth is
  # the same as the number of wirings.
  def apply_until_match(initial_state, diagram, wiring, presses \\ 1)
  def apply_until_match(_initial_state, _diagram, [], _presses), do: @no_convergence
  def apply_until_match(diagram, diagram, _wiring, presses), do: presses
  def apply_until_match(initial_state, diagram, wiring, presses) do
    AOC.inspect([initial_state, presses, diagram, wiring])
    result = wiring
    |> Enum.reduce_while([], fn wires, acc ->
      new_state = toggle(initial_state, wires)
      if new_state == diagram do
        {:halt, presses}
      else
        {:cont, acc ++ [new_state]}
      end
    end)

    if is_integer(result) do
      result
    else
      List.zip([result, wiring])
      |> Enum.map(fn {state, wires} ->
        apply_until_match(state, diagram, List.delete(wiring, wires), presses + 1)
      end)
      |> Enum.min()
    end
  end

  def fewest_presses(diagram, wiring) do
    initial_state = Enum.reduce(diagram, %{}, fn {k, _v}, acc ->
      Map.put(acc, k, false)
    end)
    apply_until_match(initial_state, diagram, wiring)
  end
  
  def solve1(text) do
    text
    |> AOC.as_single_lines()
    |> Enum.map(fn line ->
      [diagram, wiring, _joltage] = parse_line(line)
      fewest_presses(diagram, wiring)
      |> AOC.inspect()
    end)
    |> AOC.inspect(label: "to sum")
    |> Enum.sum()
  end

  # def solve2(text) do
  # end
end

# Example:

IO.inspect(Time.utc_now())
data.()
|> Day10.solve1()
|> IO.inspect(label: "\n*** Part 1 solution (example: 7)")
#

# data.()
# |> Day10.solve2()
# |> IO.inspect(label: "\n*** Part 2 solution (example: )")
# 

```
