## Installation and Data

```elixir
input_example = Kino.Input.textarea("Example Data", monospace: true)
```

<!-- livebook:{"reevaluate_automatically":true} -->

```elixir
input_puzzleInput = Kino.Input.textarea("Puzzle Input", monospace: true)
```

<!-- livebook:{"reevaluate_automatically":true} -->

```elixir
input_source_select =
  Kino.Input.select("Source", [{:example, "example"}, {:puzzle_input, "puzzle input"}])
```

<!-- livebook:{"reevaluate_automatically":true} -->

```elixir
data = fn ->
  (Kino.Input.read(input_source_select) == :example &&
     Kino.Input.read(input_example)) ||
    Kino.Input.read(input_puzzleInput)
end
```

## Solution

```elixir
defmodule Day11 do
  def find_paths(map, from, to, path_so_far \\ []) do
    Enum.reduce(map[from] || [], [], fn device, acc ->
      # AOC.inspect(device)
      cond do
        device == to -> acc ++ path_so_far ++ [to]
        device in path_so_far -> acc
        true -> acc ++ [find_paths(map, device, to, path_so_far ++ [device])]
      end
    end)
    |> List.flatten()
    # |> AOC.inspect(label: "end of find_paths")
  end
  
  def find_paths2(map, from, to, path_so_far \\ []) do
    Enum.reduce(map[from] || [], [], fn device, acc ->
      # AOC.inspect(device)
      cond do
        (device == to) && ("dac" in path_so_far) && ("fft" in path_so_far) -> acc ++ path_so_far ++ [to]
        device == to -> acc
        device in path_so_far -> acc
        true -> acc ++ [find_paths2(map, device, to, path_so_far ++ [device])]
      end
    end)
    |> List.flatten()
    # |> AOC.inspect(label: "end of find_paths")
  end
  
  def solve1(text) do
    connections = text
      |> AOC.as_single_lines()
      |> Enum.reduce(%{}, fn line, acc ->
        [from, to] = String.split(line, ": ")
        to = to |> String.split(" ", trim: true)
        Map.put(acc, from, to)
      end)
      # |> AOC.inspect()

    {paths, _junk} = find_paths(connections, "you", "out")
      |> Enum.reduce({[], []}, fn device, {result, in_process} ->
        if device == "out" do
          {result ++ [in_process], []}
        else
          {result, in_process ++ [device]}
        end
      end)
    IO.puts("\n*** Part 1 solution (example: 5) #{Enum.count(paths)}")

    # {paths, _junk} = find_paths2(connections, "svr", "out")
    #   |> Enum.reduce({[], []}, fn device, {result, in_process} ->
    #     if device == "out" do
    #       {result ++ [in_process], []}
    #     else
    #       {result, in_process ++ [device]}
    #     end
    #   end)

    # paths = paths
    #   |> Enum.filter(fn path ->
    #     ("dac" in path) && ("fft" in path)
    #   end)
    # IO.puts("\n*** Part 2 solution (example: 2) #{Enum.count(paths)}")
  end

  # def solve2(text) do
  # end
end

# Example:

IO.inspect(Time.utc_now())
data.()
|> Day11.solve1()
# |> IO.inspect(label: "\n*** Part 1 solution (example: 5)")
